# CarRada Server Configuration

# Server port (default: 4000)
PORT=4000

# PostgreSQL database URL
DATABASE_URL=postgresql://carbuddy:carbuddy@localhost:5432/carbuddy

# JWT secret for token signing (change this in production!)
JWT_SECRET=your-secret-key-here

# Groq API key for fast AI inference (required for AI features)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: Claude API key (fallback, not required if Groq is set)
# CLAUDE_API_KEY=sk_ant_your_claude_key_here
